<?xml version="1.0" encoding="utf-8"?>
<com.vsoontech.ui.tvlayout.TvFrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  >
  <com.vsoontech.ui.tvlayout.TvConstraintLayout
    android:layout_width="690px"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    >
    <ImageView
      android:id="@+id/update_dialog_top_img"
      android:layout_width="690px"
      android:layout_height="400px"
      android:src="@drawable/bg_update_yueting"
      />
    <TextView
        android:id="@+id/update_dialog_top_title_txt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Upgrade to"
        android:textColor="#FFFFFFFF"
        android:textSize="50px"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="none"
        android:shadowColor="#66000000"
        android:shadowDx="3"
        android:shadowDy="4"
        android:shadowRadius="2"
        app:layout_constraintTop_toTopOf="@id/update_dialog_top_img"
        app:layout_constraintLeft_toLeftOf="@id/update_dialog_top_img"
        app:layout_constraintRight_toRightOf="@id/update_dialog_top_img"
        android:layout_marginLeft="180px"
        android:layout_marginRight="45px"
        android:layout_marginTop="95px" />

    <TextView
        android:id="@+id/update_dialog_top_title_txt2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="the new version"
        android:textColor="#FFFFFFFF"
        android:textSize="50px"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="none"
        android:shadowColor="#66000000"
        android:shadowDx="3"
        android:shadowDy="4"
        android:shadowRadius="2"
        app:layout_constraintTop_toBottomOf="@id/update_dialog_top_title_txt"
        app:layout_constraintLeft_toLeftOf="@id/update_dialog_top_title_txt"
        app:layout_constraintRight_toRightOf="@id/update_dialog_top_title_txt"
        android:layout_marginTop="10dp" />

    <View
      android:id="@+id/update_dialog_bottom_view"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:layout_constraintTop_toBottomOf="@id/update_dialog_top_img"
      app:layout_constraintBottom_toBottomOf="parent"
      android:background="@drawable/bg_update_dialog_bottom"
      />
    <TextView
      android:id="@+id/update_dialog_title_txt"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintLeft_toLeftOf="parent"
      android:layout_marginLeft="78px"
      android:layout_marginTop="340px"
      android:text="What's New"
      android:textColor="#ff6c6c6c"
      android:textSize="32px"
      />
    <TextView
      android:id="@+id/update_dialog_desc_txt"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintLeft_toLeftOf="@id/update_dialog_title_txt"
      app:layout_constraintRight_toRightOf="@id/update_dialog_top_img"
      app:layout_constraintTop_toBottomOf="@id/update_dialog_title_txt"
      android:layout_marginRight="78px"
      android:layout_marginTop="15px"
      android:minHeight="100px"
      android:lineSpacingMultiplier="1.3"
      android:textColor="#797676"
      android:textSize="27px"
      tools:text="1、新增新闻资讯内容, 内容有点长看看怎么样, 分行试试看;\n2、开机画面可以右键跳过哦;\n3、优化频道和排行榜的体验"
      />
    <Button
      android:id="@+id/update_dialog_ok_btn"
      android:layout_width="205px"
      android:layout_height="60px"
      app:layout_constraintLeft_toLeftOf="@id/update_dialog_top_img"
      app:layout_constraintRight_toLeftOf="@+id/update_dialog_cancel_btn"
      app:layout_constraintTop_toBottomOf="@id/update_dialog_desc_txt"
      app:layout_constraintBottom_toBottomOf="parent"
      android:layout_marginTop="30px"
      app:layout_goneMarginTop="15px"
      android:layout_marginBottom="40px"
      app:layout_constraintHorizontal_chainStyle="packed"
      android:background="@drawable/bg_update_btn"
      android:gravity="center"
      android:text="Update Now"
      android:textColor="@color/update_btn_text"
      android:textSize="30px"
      >
      <requestFocus/>
    </Button>

    <Button
      android:id="@+id/update_dialog_cancel_btn"
      android:layout_width="205px"
      android:layout_height="60px"
      app:layout_constraintLeft_toRightOf="@id/update_dialog_ok_btn"
      app:layout_constraintRight_toRightOf="@id/update_dialog_top_img"
      app:layout_constraintTop_toTopOf="@id/update_dialog_ok_btn"
      android:layout_marginLeft="70px"
      android:background="@drawable/bg_update_btn"
      android:gravity="center"
      android:text="Not Now"
      android:textColor="@color/update_btn_text"
      android:textSize="30px"
      />
  </com.vsoontech.ui.tvlayout.TvConstraintLayout>
</com.vsoontech.ui.tvlayout.TvFrameLayout>