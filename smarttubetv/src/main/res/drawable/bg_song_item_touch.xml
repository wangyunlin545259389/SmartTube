    <!-- 遥控器焦点 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#2A2944" />
            <stroke
                android:width="2dp"
                android:color="#BB86FC" />
        </shape>
    </item>

    <!-- 代码里 setSelected(true) 时 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#2A2944" />
            <stroke
                android:width="2dp"
                android:color="#BB86FC" />
        </shape>
    </item>

    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#1E1D33" />
            <stroke
                android:width="1dp"
                android:color="#30304A" />
        </shape>
    </item>

</selector>